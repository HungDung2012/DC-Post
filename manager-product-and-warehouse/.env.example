# Local development. Use the same JWT secret as the Identity & User Service.
HTTP_PORT=8082
JWT_SECRET=replace-with-the-shared-jwt-secret

POSTGRES_DB=dc_post
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Used when running Go on the host. Update this DSN if the database settings change.
DB_DSN=postgres://postgres:postgres@localhost:5432/dc_post?sslmode=disable

# Optional host port for the API container. The API listens on 8082 in the container.
API_PORT=8082
# Set DOCKER_DB_DSN to override the container connection URL; URL-encode special characters in credentials.
# DOCKER_DB_DSN=postgres://postgres:postgres@postgres:5432/dc_post?sslmode=disable
